# Copie para servidor.env (não versionado) e ajuste os caminhos do servidor.
#   cp servidor.env.example servidor.env

# Pasta com os datasets (montada somente leitura em /dados no container).
DADOS_DIR=/caminho/para/dados

# Pasta com Best_LA_model_for_DF.pth e xlsr2_300m.pt (montada somente leitura em /ckpt).
CKPT_DIR=/caminho/para/checkpoints

# Imagem construída a partir de experimentos/01-linha-de-base/docker/Dockerfile.
IMAGEM=residencia-exp01:pt181

# Se o seu usuário precisar de sudo para o docker, descomente:
# DOCKER="sudo docker"
